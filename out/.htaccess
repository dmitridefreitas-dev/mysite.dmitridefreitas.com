<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
	# Cache everything on CDN by default; index.html revalidates so deploys show up
	Header set Cache-Control "public, s-maxage=604800, max-age=0"

	# Hashed build assets are immutable — cache aggressively in the browser
	<If "%{REQUEST_URI} =~ m#^/assets/.*$#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>

	# Media rarely changes — cache a week in browser
	<If "%{REQUEST_URI} =~ m#\.(mp4|jpe?g|png|webp|pdf)$#">
		Header set Cache-Control "public, max-age=604800"
	</If>

	# Security hardening
	Header set X-Content-Type-Options "nosniff"
	Header set Referrer-Policy "strict-origin-when-cross-origin"
	Header set X-Frame-Options "SAMEORIGIN"
	Header set Permissions-Policy "camera=(), geolocation=(), payment=()"
</IfModule>
