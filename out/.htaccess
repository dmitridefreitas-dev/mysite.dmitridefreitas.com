<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
	# Default: always revalidate. This covers index.html and every SPA route,
	# so a deploy is visible immediately — no manual CDN purge needed.
	# (Hashed assets below carry the real long-term caching.)
	Header set Cache-Control "no-cache, must-revalidate"

	# Hashed build assets are immutable — cache aggressively everywhere
	<If "%{REQUEST_URI} =~ m#^/assets/.*$#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>

	# Media rarely changes — cache a week
	<If "%{REQUEST_URI} =~ m#\.(mp4|jpe?g|png|webp|pdf)$#">
		Header set Cache-Control "public, max-age=604800"
	</If>

	# Security hardening
	Header set X-Content-Type-Options "nosniff"
	Header set Referrer-Policy "strict-origin-when-cross-origin"
	Header set X-Frame-Options "SAMEORIGIN"
	Header set Permissions-Policy "camera=(), geolocation=(), payment=()"
</IfModule>
